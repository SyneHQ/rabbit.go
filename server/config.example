# Rabbit configuration. Copy to .env for local development; inject production
# values through your service's secret provider. Never commit populated secrets.

# New metadata: standalone. Existing application metadata: postgoose.
# The identity mode cannot be changed on the same metadata database.
RABBIT_IDENTITY_MODE=standalone

# Local development only. Both stores are needed by the migration command too.
DATABASE_URL=postgres://postgres:password@localhost:5432/rabbit?sslmode=disable
REDIS_URL=redis://localhost:6379/0

# Production metadata must stay private. Use PostgreSQL sslmode=verify-full with
# the correct hostname/CA and authenticated Redis over rediss://.

# Required for management: supply a secret of at least 32 characters.
RABBIT_SERVICE_TOKEN=

# Mount a readable PEM pair. These are file paths, not PEM contents.
RABBIT_TLS_CERT_FILE=/run/rabbit-tls/tls.crt
RABBIT_TLS_KEY_FILE=/run/rabbit-tls/tls.key
ENVIRONMENT=production

# Optional admission and timeout overrides; see docs/operator-limits.md.
RABBIT_MAX_CONNECTIONS=4096
RABBIT_MAX_CONNECTIONS_PER_IP=100
RABBIT_IDLE_TIMEOUT=30m

# Bindings and API port are CLI flags, not environment settings:
# rabbit.go server --bind 0.0.0.0 --port 9999 \
#   --tunnel-bind 127.0.0.1 --api-bind 127.0.0.1 --api-port 3422
# Loopback is shared only within the same network namespace.
# Token ingress ports are allocated from 10000-65535; MIN_PORT/MAX_PORT do not apply.
